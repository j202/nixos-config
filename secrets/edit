#!/usr/bin/env bash
# Edit an agenix secret without leaking its plaintext. See README (Secrets).
set -euo pipefail

[ $# -eq 1 ] || {
  echo "usage: ${0##*/} <name>.age" >&2
  exit 1
}

# agenix finds agenix-rules.nix relative to the current directory.
cd "$(dirname "$(readlink -f "$0")")"

# Bare nvim: no config/plugins, no swap (-n), no shada (-i NONE), so the
# decrypted text never lands in ~/.local. Don't use sudo -E for the same reason.
EDITOR='nvim --clean -n -i NONE' exec sudo --preserve-env=EDITOR agenix -e "$1" -i /etc/age/key
